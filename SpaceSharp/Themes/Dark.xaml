<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme colors. Every key here must also exist in the other theme file. -->
    <SolidColorBrush x:Key="Bg" Color="#0D1117" />
    <SolidColorBrush x:Key="Panel" Color="#161B22" />
    <SolidColorBrush x:Key="Control" Color="#21262D" />
    <SolidColorBrush x:Key="ControlHover" Color="#2B3139" />
    <SolidColorBrush x:Key="ControlPressed" Color="#363D47" />
    <SolidColorBrush x:Key="Stroke" Color="#30363D" />
    <SolidColorBrush x:Key="MenuBg" Color="#1C2128" />
    <SolidColorBrush x:Key="Text" Color="#E6EDF3" />
    <SolidColorBrush x:Key="TextDim" Color="#8B949E" />
    <SolidColorBrush x:Key="Accent" Color="#F5B82E" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFC94D" />
    <SolidColorBrush x:Key="AccentPressed" Color="#D99F1C" />
    <SolidColorBrush x:Key="AccentText" Color="#1C1500" />
    <SolidColorBrush x:Key="Danger" Color="#FF7070" />
    <SolidColorBrush x:Key="MapBg" Color="#0D1117" />
    <SolidColorBrush x:Key="Scrim" Color="#C80D1117" />
</ResourceDictionary>
