<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme colors. Every key here must also exist in the other theme file. -->
    <SolidColorBrush x:Key="Bg" Color="#17171C" />
    <SolidColorBrush x:Key="Panel" Color="#202027" />
    <SolidColorBrush x:Key="Control" Color="#2A2A33" />
    <SolidColorBrush x:Key="ControlHover" Color="#34343F" />
    <SolidColorBrush x:Key="ControlPressed" Color="#3F3F4C" />
    <SolidColorBrush x:Key="Stroke" Color="#383843" />
    <SolidColorBrush x:Key="MenuBg" Color="#26262E" />
    <SolidColorBrush x:Key="Text" Color="#ECECF1" />
    <SolidColorBrush x:Key="TextDim" Color="#9C9CAC" />
    <SolidColorBrush x:Key="Accent" Color="#F5B82E" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFC94D" />
    <SolidColorBrush x:Key="AccentPressed" Color="#D99F1C" />
    <SolidColorBrush x:Key="AccentText" Color="#1C1500" />
    <SolidColorBrush x:Key="Danger" Color="#FF7070" />
    <SolidColorBrush x:Key="MapBg" Color="#17171C" />
    <SolidColorBrush x:Key="Scrim" Color="#C8121216" />
</ResourceDictionary>
