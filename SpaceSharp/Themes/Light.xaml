<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme colors. Every key here must also exist in the other theme file. -->
    <SolidColorBrush x:Key="Bg" Color="#F3F3F6" />
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Control" Color="#ECECF1" />
    <SolidColorBrush x:Key="ControlHover" Color="#E2E2E9" />
    <SolidColorBrush x:Key="ControlPressed" Color="#D6D6DF" />
    <SolidColorBrush x:Key="Stroke" Color="#D6D6DE" />
    <SolidColorBrush x:Key="MenuBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text" Color="#1C1C22" />
    <SolidColorBrush x:Key="TextDim" Color="#61616F" />
    <SolidColorBrush x:Key="Accent" Color="#F5B82E" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFC94D" />
    <SolidColorBrush x:Key="AccentPressed" Color="#D99F1C" />
    <SolidColorBrush x:Key="AccentText" Color="#1C1500" />
    <SolidColorBrush x:Key="Danger" Color="#D33A3A" />
    <SolidColorBrush x:Key="MapBg" Color="#D9D9E1" />
    <SolidColorBrush x:Key="Scrim" Color="#B3F3F3F6" />
</ResourceDictionary>
