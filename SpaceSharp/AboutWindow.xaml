<Window x:Class="SpaceSharp.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpaceSharp.Util"
        Title="{u:T About_AboutSpaceSharp}"
        Width="720" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/SpaceSharp.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{u:T About_Close}"
                        IsDefault="True" IsCancel="True" Click="Close_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE8C8;" Content="{u:T About_CopyVersionInfo}"
                            Click="CopyInfo_Click" />
                    <Button x:Name="UpdateButton" Style="{StaticResource ToolButton}" Tag="&#xE895;"
                            Content="{u:T About_CheckForUpdates}" Margin="6,0,0,0" Click="CheckUpdates_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="28,26,28,24">
            <DockPanel>
                <Image Source="/Assets/SpaceSharp-256.png" Width="96" Height="96" Margin="0,0,22,0"
                       VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SpaceSharp" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource TextDim}" Margin="0,2,0,0" />
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="20" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{u:T About_Shortcuts}" FontSize="15" FontWeight="SemiBold" Margin="0,26,0,8" />
            <Grid x:Name="ShortcutGrid" />

            <TextBlock Text="{u:T About_System}" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,6" />
            <TextBlock x:Name="SystemText" Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" />

            <TextBlock Text="{u:T About_Credits}" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,6" />
            <TextBlock Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" LineHeight="20" Text="{u:T About_CreditsText}" />

            <TextBlock Text="{u:T About_Feedback}" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,6" />
            <TextBlock Foreground="{DynamicResource TextDim}" TextWrapping="Wrap" LineHeight="20"
                       Text="{u:T About_FoundAProblemOr}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource ToolButton}" Tag="&#xEBE8;" Content="{u:T About_ReportABug}" Click="ReportBug_Click" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xEA80;" Content="{u:T About_SuggestAFeature}" Margin="6,0,0,0" Click="SuggestFeature_Click" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE774;" Content="GitHub" Margin="6,0,0,0" Click="OpenGitHub_Click" />
            </StackPanel>

            <TextBlock x:Name="CopyrightText" Foreground="{DynamicResource TextDim}" Margin="0,22,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
