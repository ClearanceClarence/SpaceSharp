<Window x:Class="SpaceSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SpaceSharp.Controls"
        Title="SpaceSharp"
        Width="1400" Height="880" MinWidth="1040" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/SpaceSharp.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">

    <DockPanel>
        <!-- ============================================================ top bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Style" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="StyleCombo" Width="118" SelectionChanged="ColorSettings_Changed">
                        <ComboBoxItem Content="Classic" />
                        <ComboBoxItem Content="Tiles" />
                        <ComboBoxItem Content="Cards" />
                        <ComboBoxItem Content="Bands" />
                        <ComboBoxItem Content="Terraces" />
                        <ComboBoxItem Content="Soft" />
                    </ComboBox>
                    <TextBlock Text="Color by" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                               Margin="14,0,8,0" />
                    <ComboBox x:Name="ColorCombo" Width="120" SelectionChanged="ColorSettings_Changed">
                        <ComboBoxItem Content="Depth" />
                        <ComboBoxItem Content="File type" />
                    </ComboBox>
                    <TextBlock Text="Palette" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                               Margin="14,0,8,0" />
                    <ComboBox x:Name="PaletteCombo" Width="180" MaxDropDownHeight="480"
                              SelectionChanged="ColorSettings_Changed">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="9" Height="14" Margin="0,0,1,0" CornerRadius="2"
                                                        Background="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Style="{StaticResource ToolDivider}" />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE713;"
                            ToolTip="Settings (Ctrl+,)" Click="SettingsButton_Click" />
                    <Button x:Name="ThemeButton" Style="{StaticResource ToolButton}" Tag="&#xE708;"
                            ToolTip="Theme" Click="ThemeButton_Click" />
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE946;" ToolTip="About SpaceSharp (F1)"
                            Click="About_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ScanFolderButton" Style="{StaticResource AccentButton}"
                            Tag="&#xE838;" Content="Scan folder" Click="ScanFolder_Click" />
                    <Button x:Name="RescanButton" Style="{StaticResource ToolButton}"
                            Tag="&#xE72C;" ToolTip="Rescan (F5)" Click="Rescan_Click" />

                    <Border Style="{StaticResource ToolDivider}" />

                    <Button x:Name="UpButton" Style="{StaticResource ToolButton}"
                            Tag="&#xE74A;" ToolTip="Up one folder (Backspace / mouse back)" Click="Up_Click" />
                    <Button x:Name="FitButton" Style="{StaticResource ToolButton}"
                            Tag="&#xE80F;" ToolTip="Show whole map (Home / Ctrl+0)" Click="Fit_Click" />
                    <Button x:Name="ListsButton" Style="{StaticResource ToolButton}"
                            Tag="&#xE90A;" ToolTip="Drives and largest items panel (L)" Click="Lists_Click" />

                    <Border Style="{StaticResource ToolDivider}" />

                    <Button x:Name="ZoomOutButton" Style="{StaticResource ToolButton}"
                            Tag="&#xE71F;" ToolTip="Zoom out (mouse wheel / −)" Click="ZoomOut_Click" />
                    <TextBlock x:Name="ZoomLabel" Width="64" TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDim}" Text="—" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource ToolButton}"
                            Tag="&#xE8A3;" ToolTip="Zoom in (mouse wheel / +)" Click="ZoomIn_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================ protected folders notice -->
        <Border x:Name="AccessBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="4,0,0,1" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="&#xE711;" Height="28"
                        ToolTip="Dismiss" Click="CloseAccessBar_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="28" Margin="12,0,6,0"
                        Tag="&#xE7EF;" Content="Restart as administrator" Click="RestartElevated_Click" />
                <TextBlock x:Name="AccessText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ============================================================ update notice -->
        <Border x:Name="UpdateBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="4,0,0,1" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="&#xE711;" Height="28"
                        ToolTip="Not now" Click="CloseUpdateBar_Click" />
                <Button x:Name="InstallUpdateButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="28"
                        Margin="12,0,6,0" Tag="&#xE896;" Content="Install and restart" Click="InstallUpdate_Click" />
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ============================================================ breadcrumb -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,0,0,1" Padding="6,4" MinHeight="36">
            <DockPanel>
                <Grid DockPanel.Dock="Right" Width="360" Margin="12,0,4,0" VerticalAlignment="Center">
                    <TextBox x:Name="FilterBox" Style="{StaticResource FilterBox}" Height="28" Padding="30,0,56,0"
                             Tag="Filter, e.g. videos over 500MB older than 1 year"
                             TextChanged="FilterBox_TextChanged" PreviewKeyDown="FilterBox_PreviewKeyDown" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,3,0">
                        <Button x:Name="ClearFilterButton" Style="{StaticResource ToolButton}" Tag="&#xE711;" Height="22"
                                MinWidth="22" Padding="4,0" Visibility="Collapsed" ToolTip="Clear filter (Esc)"
                                Click="ClearFilter_Click" />
                        <Button x:Name="FilterPanelButton" Style="{StaticResource ToolButton}" Tag="&#xE71C;" Height="22"
                                MinWidth="22" Padding="4,0" ToolTip="Filter options" Click="FilterPanel_Click" />
                    </StackPanel>
                    <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterBox}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                        <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14" Margin="0,0,12,12" Width="400">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <StackPanel x:Name="FilterPanelBody" />
                        </Border>
                    </Popup>
                </Grid>
                <Button x:Name="SelectMatchesButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Height="28"
                        Tag="&#xE8B3;" Content="Select matches" Visibility="Collapsed" Margin="8,0,0,0"
                        ToolTip="Select every matching file (Ctrl+A), then Del to recycle them" Click="SelectMatches_Click" />
                <TextBlock x:Name="FilterInfo" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" />
                <WrapPanel x:Name="LegendPanel" DockPanel.Dock="Right" Visibility="Collapsed"
                           VerticalAlignment="Center" Margin="12,0,4,0" />
                <TextBlock x:Name="BreadcrumbInfo" DockPanel.Dock="Right" Foreground="{DynamicResource TextDim}"
                           VerticalAlignment="Center" Margin="12,0,4,0" />
                <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" ClipToBounds="True"
                            VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ============================================================ status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="StatusScan" DockPanel.Dock="Right" Foreground="{DynamicResource TextDim}"
                           Margin="16,0,0,0" />
                <TextBlock x:Name="StatusHover" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ============================================================ side panel: top lists -->
        <Border x:Name="SidePanel" DockPanel.Dock="Left" Width="340"
                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- drives -->
                <TextBlock DockPanel.Dock="Top" Text="Drives" FontSize="15" FontWeight="SemiBold" Margin="14,12,14,4" />
                <TextBlock DockPanel.Dock="Top" Text="Click a drive to scan it." Foreground="{DynamicResource TextDim}"
                           FontSize="12" Margin="14,0,14,4" />
                <ListBox x:Name="DriveList" DockPanel.Dock="Top" MaxHeight="320" SelectionChanged="DriveList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource TextDim}" Margin="0,1,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding FreeText}" Foreground="{DynamicResource TextDim}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="6" Margin="0,7,0,5">
                                    <Border Background="{DynamicResource Control}" CornerRadius="3" />
                                    <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="3"
                                            Background="{DynamicResource Accent}" Opacity="0.9" />
                                </Grid>
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}"
                                           Foreground="{DynamicResource TextDim}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Stroke}" Margin="14,8,14,6" />

                <!-- largest items -->
                <TextBlock DockPanel.Dock="Top" Text="Largest items" FontSize="15" FontWeight="SemiBold" Margin="14,4,14,2" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,10,4">
                    <Button x:Name="TabFiles" Style="{StaticResource TabButton}" Content="Files" Click="Tab_Click" />
                    <Button x:Name="TabFolders" Style="{StaticResource TabButton}" Content="Folders" Click="Tab_Click" />
                    <Button x:Name="TabTypes" Style="{StaticResource TabButton}" Content="Types" Click="Tab_Click" />
                </StackPanel>
                <TextBlock x:Name="ListHint" DockPanel.Dock="Top" Foreground="{DynamicResource TextDim}" FontSize="12"
                           Margin="14,0,14,6" TextTrimming="CharacterEllipsis" />
                <ListBox x:Name="TopList" SelectionChanged="TopList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="3" HorizontalAlignment="Left" Width="{Binding BarWidth}" Height="3"
                                        VerticalAlignment="Bottom" Margin="0,0,0,-4" CornerRadius="2"
                                        Background="{DynamicResource Accent}" Opacity="0.55" />
                                <Border Width="10" Height="10" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Background="{Binding Swatch}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="11"
                                               Foreground="{DynamicResource TextDim}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================ map -->
        <Grid Background="{DynamicResource Bg}">
            <controls:TreemapControl x:Name="Treemap" MapBackground="{DynamicResource MapBg}">
                <controls:TreemapControl.ContextMenu>
                    <ContextMenu Opened="TreemapMenu_Opened">
                        <MenuItem x:Name="MenuFocus" Header="Zoom to folder" InputGestureText="Double-click"
                                  Click="MenuFocus_Click">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8A3;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuUp" Header="Up one folder" InputGestureText="Backspace"
                                  Click="Up_Click">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74A;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuFit" Header="Show whole map" InputGestureText="Home"
                                  Click="Fit_Click">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE80F;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MenuOpen" Header="Open" Click="MenuOpen_Click">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8E5;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuExplorer" Header="Show in Explorer" Click="MenuExplorer_Click">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE838;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuCopy" Header="Copy path" InputGestureText="Ctrl+C"
                                  Click="MenuCopy_Click">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MenuDelete" Header="Move to Recycle Bin" InputGestureText="Del"
                                  Foreground="{DynamicResource Danger}" Click="MenuDelete_Click">
                            <MenuItem.Icon>
                                <TextBlock Style="{StaticResource MenuIcon}" Text="&#xE74D;" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </controls:TreemapControl.ContextMenu>
            </controls:TreemapControl>

            <StackPanel x:Name="EmptyHint" IsHitTestVisible="False"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Assets/SpaceSharp-256.png" Width="88" Height="88" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Click a drive on the left, or choose a folder to scan."
                           Foreground="{DynamicResource TextDim}" FontSize="15" Margin="0,14,0,0" />
            </StackPanel>

            <Popup x:Name="HoverTip" Placement="Relative" PlacementTarget="{Binding ElementName=Treemap}"
                   AllowsTransparency="True" IsHitTestVisible="False" StaysOpen="True" Focusable="False">
                <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                        CornerRadius="8" Padding="12,9" Margin="0,0,10,10" MaxWidth="420">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="TipName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Text}" />
                        <TextBlock x:Name="TipPath" FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextDim}" Margin="0,1,0,6" />
                        <Grid x:Name="TipRows">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>

            <Grid x:Name="ScanOverlay" Background="{DynamicResource Scrim}" Visibility="Collapsed">
                <Border Width="620" Padding="28,24,28,22" CornerRadius="12" Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- title -->
                        <DockPanel>
                            <Image DockPanel.Dock="Left" Source="/Assets/SpaceSharp-256.png" Width="44" Height="44"
                                   Margin="0,0,16,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ScanTitle" Text="Scanning…" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock x:Name="ScanSubtitle" Foreground="{DynamicResource TextDim}" Margin="0,2,0,0"
                                           Text="Reading the folder tree. The map appears when it's done." />
                            </StackPanel>
                        </DockPanel>

                        <!-- counters -->
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Control}" CornerRadius="8" Padding="14,10">
                                <StackPanel>
                                    <TextBlock x:Name="ScanSizeText" Text="0 B" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="found so far" Foreground="{DynamicResource TextDim}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource Control}" CornerRadius="8" Padding="14,10">
                                <StackPanel>
                                    <TextBlock x:Name="ScanFilesText" Text="0" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="files" Foreground="{DynamicResource TextDim}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{DynamicResource Control}" CornerRadius="8" Padding="14,10">
                                <StackPanel>
                                    <TextBlock x:Name="ScanFoldersText" Text="0" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="folders" Foreground="{DynamicResource TextDim}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- progress bar: determinate for whole drives, sweeping for folders -->
                        <Grid x:Name="ScanBar" Height="6" Margin="0,20,0,8" ClipToBounds="True">
                            <Border Background="{DynamicResource Control}" CornerRadius="3" />
                            <Border x:Name="ScanBarFill" Background="{DynamicResource Accent}" CornerRadius="3"
                                    HorizontalAlignment="Left" Width="160">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ScanBarSweep" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <DockPanel>
                            <TextBlock x:Name="ScanElapsedText" DockPanel.Dock="Right" Foreground="{DynamicResource TextDim}" FontSize="12" />
                            <TextBlock x:Name="ScanRateText" Foreground="{DynamicResource TextDim}" FontSize="12" />
                        </DockPanel>

                        <!-- current folder -->
                        <Border Margin="0,16,0,0" Padding="10,7" CornerRadius="6" Background="{DynamicResource Control}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{DynamicResource TextDim}" Margin="0,1,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ScanPathText" Foreground="{DynamicResource TextDim}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <Button x:Name="CancelButton" Style="{StaticResource ToolButton}" Tag="&#xE711;"
                                Content="Cancel  (Esc)" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Cancel_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
