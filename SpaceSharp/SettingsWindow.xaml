<Window x:Class="SpaceSharp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="640" Height="760" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/SpaceSharp.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Close"
                        IsDefault="True" IsCancel="True" Click="Close_Click" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE777;" Content="Reset to defaults"
                        HorizontalAlignment="Left" Click="Reset_Click" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel x:Name="Body" Margin="28,22,22,10" />
        </ScrollViewer>
    </DockPanel>
</Window>
